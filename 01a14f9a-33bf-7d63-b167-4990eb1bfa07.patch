+        unlockAudio();
+        if (e.key === 'F1') { e.preventDefault(); toggleHud(); }
+      }, true);
+      window.addEventListener('mousemove', function () { if (hudVisible) updateHud(); }, true);
+
+      if (el.play) el.play.addEventListener('click', function (e) {
+        e.preventDefault();
+        e.stopPropagation();
+        begin();
+      });
+      if (el.audio) el.audio.addEventListener('click', function (e) {
+        e.stopPropagation();
+        toggleAudio();
+      });
+      if (el.fullscreen) el.fullscreen.addEventListener('click', function (e) {
+        e.stopPropagation();
+        if (!document.fullscreenElement) {
+          if (el.stage.requestFullscreen) el.stage.requestFullscreen();
+        } else if (document.exitFullscreen) {
+          document.exitFullscreen();
+        }
+      });
+      if (el.canvas) el.canvas.addEventListener('pointerdown', function () {
+        if (!started) begin();
+        el.canvas.focus();
+      });
+
+      var reloadBtn = document.getElementById('diag-reload');
+      if (reloadBtn) reloadBtn.addEventListener('click', function () { location.reload(); });
+      var hideBtn = document.getElementById('diag-hide');
+      if (hideBtn) hideBtn.addEventListener('click', function () { el.diag.classList.add('hidden'); });
+      var hudBtn = document.getElementById('diag-hud');
+      if (hudBtn) hudBtn.addEventListener('click', function () { toggleHud(true); el.diag.classList.add('hidden'); });
+
+      window.addEventListener('error', function (ev) {
+        if (failed) return;
+        log('window.error: ' + (ev.message || ev.type));
+        fail('Ошибка в браузере',
+             'Игра не смогла загрузиться. Ниже — текст ошибки и последние строки лога.',
+             ev.message ? String(ev.message) : null);
+      });
+
+      window.addEventListener('unhandledrejection', function (ev) {
+        if (failed) return;
+        var reason = ev.reason && (ev.reason.message || ev.reason);
+        log('unhandledrejection: ' + reason);
+        if (isFileProtocol()) return;
+        fail('Ошибка загрузки файлов игры',
+             'Браузер не смог получить <code style="display:inline;padding:2px 4px;">index.wasm</code> или <code style="display:inline;padding:2px 4px;">index.data</code>. ' +
+             'Проверьте, что все четыре файла лежат рядом с index.html и что страница открыта через http://, а не file://.',
+             reason ? String(reason) : null);
+      });
+
+      if (isFileProtocol()) showFileWarning();
+
+      // Страховка: буфер canvas должен оставаться 1920x1080
+      setInterval(function () { enforceBuffer(); }, 1000);
+
+      setTimeout(function () {
+        if (!ready && !started && !failed) {
+          fail('Игра не запустилась',
+               'Загрузка не завершилась за 25 секунд. Ниже — лог, который обычно объясняет причину.',
+               null);
+        }
+      }, 25000);
+
+      return {
+        log: log,
+        hideLoader: hideLoader,
+        showStart: function () { showStart(); enforceBuffer(); updateHud(); },
+        begin: begin,
+        fail: fail,
+        fit: fitToWindow,
+        enforceBuffer: enforceBuffer,
+        updateHud: updateHud,
+        getScale: function () { return scale; },
+        setStatus: function (text) {
+          if (isFileProtocol()) return;
+          if (!text) { hideLoader(); showStart(); return; }
+          var m = text.match(/([^(]+)\((\d+(\.\d+)?)\/(\d+)\)/);
+          if (m) {
+            var pct = Math.max(0, Math.min(100, parseInt(m[2], 10) * 100 / parseInt(m[4], 10)));
+            if (el.bar) el.bar.style.width = pct.toFixed(1) + '%';
+            if (el.status) el.status.textContent = 'Загрузка ' + Math.round(pct) + '%';
+          } else if (el.status) {
+            el.status.textContent = text;
+          }
+        }
+      };
+    })();
+  </script>
+
+  <script>
+    var Module = {
+      canvas: document.getElementById('canvas'),
+      print: function (text) { console.log(text); if (window.LIFT) window.LIFT.log(text); },
+      printErr: function (text) { console.error(text); if (window.LIFT) window.LIFT.log('ERR: ' + text); },
+      setStatus: function (text) { if (window.LIFT) window.LIFT.setStatus(text); },
+      monitorRunDependencies: function (left) {
+        if (left === 0 && window.LIFT) window.LIFT.setStatus('');
+      },
+      onRuntimeInitialized: function () {
+        if (window.LIFT) window.LIFT.showStart();
+      }
+    };
+
+    window.onerror = function (msg) {
+      if (window.LIFT) window.LIFT.log('onerror: ' + msg);
+    };
+  </script>
+
+  {{{ SCRIPT }}}
+</body>
+</html>
diff --git a/web/start-web.bat b/web/start-web.bat
new file mode 100644
index 0000000..2dbbeb6
--- /dev/null
+++ b/web/start-web.bat
@@ -0,0 +1,25 @@
+@echo off
+rem LIFT web: локальный сервер (браузер не грузит .wasm/.data через file://)
+chcp 65001 >nul
+cd /d "%~dp0"
+
+where python >nul 2>nul
+if %errorlevel%==0 (
+    set "PY=python"
+) else (
+    where py >nul 2>nul
+    if %errorlevel%==0 (
+        set "PY=py"
+    ) else (
+        echo Python не найден. Установи Python с python.org и запусти этот файл снова.
+        pause
+        exit /b 1
+    )
+)
+
+echo.
+echo   LIFT web: http://localhost:8080
+echo   Остановить: Ctrl+C
+echo.
+start "" http://localhost:8080
+%PY% -m http.server 8080
