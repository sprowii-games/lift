@@ -0,0 +1,38 @@
+## LIFT
+
+Короткий психологический хоррор про побег из лаборатории. Четыре этажа, лифт,
+записки и головоломки по физике.
+
+### Windows x64
+
+1. Скачайте `LIFT-windows-x64.zip` и распакуйте в любую папку.
+2. Запустите `LIFT.exe`. Рядом должны лежать `textures/`, `sounds/` и `handjet.ttf`.
+3. Ничего устанавливать не нужно — Visual C++ Redistributable не требуется.
+
+### Web
+
+- `LIFT-web.zip` — распакуйте, запустите в папке любой HTTP-сервер
+  (`python3 -m http.server 8080`) и откройте `http://localhost:8080`.
+  Открывать `index.html` двойным кликом нельзя: браузер не загрузит `.wasm` и `.data` с `file://`.
+- Онлайн-версия: https://sprowii-games.github.io/lift/ (после включения GitHub Pages
+  в Settings → Pages → Source: GitHub Actions).
+
+### Управление
+
+- `A` / `D` — идти
+- `Shift` — бежать
+- `E` — действие / ответ
+- `R` — рестарт этажа
+- `Esc` — выход
+
+### Что нового
+
+- Терминал на первом этаже теперь со спрайтом (`textures/terminal.png`).
+- Исправлена мышь в веб-версии: курсор больше не смещается вверх/влево —
+  кнопки меню нажимаются там, где на них наведён курсор.
+- В веб-сборке появился экран «Играть» (он же разблокирует звук в браузере).
+- `F1` в веб-версии показывает HUD с размерами canvas и координатами мыши.
+
+### Известные мелочи
+
+- В репозитории нет `sounds/menu.ogg`, поэтому меню без музыки.
diff --git a/.github/workflows/build-release.yml b/.github/workflows/build-release.yml
new file mode 100644
index 0000000..1df5af8
--- /dev/null
+++ b/.github/workflows/build-release.yml
@@ -0,0 +1,175 @@
+name: Build & Release
+
+on:
+  push:
+    branches:
+      - main
+    tags:
+      - "v*"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: build-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  windows:
+    name: Windows x64 (.exe)
+    runs-on: windows-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Configure
+        run: cmake -S . -B build -DCMAKE_BUILD_TYPE=Release
+
+      - name: Build
+        run: cmake --build build --config Release --parallel
+
+      - name: Package
+        shell: pwsh
+        run: |
+          $dist = "dist/LIFT-windows-x64"
+          New-Item -ItemType Directory -Force -Path $dist | Out-Null
+          Copy-Item "build/Release/LIFT.exe" -Destination $dist
+          Copy-Item README.md, LICENSE, handjet.ttf -Destination $dist
+          Copy-Item textures, sounds -Destination $dist -Recurse
+          Compress-Archive -Path "$dist/*" -DestinationPath "dist/LIFT-windows-x64.zip" -Force
+          Get-ChildItem -Recurse $dist | Select-Object FullName, Length
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: windows
+          path: dist/LIFT-windows-x64.zip
+          if-no-files-found: error
+
+  web:
+    name: Web (Emscripten)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Setup Emscripten
+        uses: mymindstorm/setup-emsdk@v14
+        with:
+          version: 3.1.64
+
+      - name: Configure
+        run: |
+          set -o pipefail
+          emcmake cmake -S . -B build-web -DCMAKE_BUILD_TYPE=Release -DPLATFORM=Web 2>&1 | tee configure.log
+
+      - name: Build
+        run: |
+          set -o pipefail
+          cmake --build build-web --parallel 2>&1 | tee build.log
+
+      - name: Report build failure
+        if: failure()
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          {
+            echo "### Web build failed"
+            echo '```'
+            tail -c 60000 build.log 2>/dev/null || true
+            tail -c 20000 configure.log 2>/dev/null || true
+            echo '```'
+          } > report.md
+
+          # Show compiler errors as check-run annotations (visible without raw logs)
+          grep -E "error:|fatal error|undefined reference|FAILED:|CMake Error" build.log configure.log 2>/dev/null \
+            | tail -n 20 | while IFS= read -r line; do
+                echo "::error title=web-build::$(printf '%s' "$line" | tr '\n' ' ' | cut -c1-800)"
+              done
+
+          echo "::notice title=web-log-tail::$(tail -n 3 build.log 2>/dev/null | tr '\n' ' ' | cut -c1-800)"
+          tail -n 80 build.log 2>/dev/null || true
+
+      - name: Package
+        run: |
+          set -e
+          ls -la build-web
+          mkdir -p dist/web
+          cp build-web/index.html build-web/index.js build-web/index.wasm build-web/index.data dist/web/
+          cp README.md LICENSE dist/web/
+          cp web/start-web.bat web/start-web.sh dist/web/
+          cd dist/web
+          zip -9 -r ../LIFT-web.zip .
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: web
+          path: dist/LIFT-web.zip
+          if-no-files-found: error
+
+      - uses: actions/upload-pages-artifact@v3
+        with:
+          path: dist/web
+
+  pages:
+    name: GitHub Pages
+    needs: web
+    if: github.event_name == 'workflow_dispatch' || github.ref == 'refs/heads/main' || startsWith(github.ref, 'refs/tags/v')
+    runs-on: ubuntu-latest
+    continue-on-error: true
+    permissions:
+      pages: write
+      id-token: write
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}
+    steps:
+      - name: Check whether Pages is enabled
+        id: check
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          if gh api "repos/$GITHUB_REPOSITORY/pages" > /dev/null 2>&1; then
+            echo "enabled=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "enabled=false" >> "$GITHUB_OUTPUT"
+            echo "::notice title=GitHub Pages::Pages пока не включён. Settings -> Pages -> Source: GitHub Actions."
+          fi
+
+      - id: deployment
+        if: steps.check.outputs.enabled == 'true'
+        uses: actions/deploy-pages@v4
+
+  release:
+    name: GitHub Release
+    needs: [windows, web]
+    if: startsWith(github.ref, 'refs/tags/v')
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/download-artifact@v4
+        with:
+          path: dist
+          merge-multiple: true
+
+      - name: Create release
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -e
+          cd dist
+          ls -lah
+          sha256sum *.zip > SHA256SUMS.txt
+          if gh release view "$GITHUB_REF_NAME" --repo "$GITHUB_REPOSITORY" > /dev/null 2>&1; then
+            gh release upload "$GITHUB_REF_NAME" \
+              LIFT-windows-x64.zip LIFT-web.zip SHA256SUMS.txt \
+              --repo "$GITHUB_REPOSITORY" --clobber
+          else
+            gh release create "$GITHUB_REF_NAME" \
+              LIFT-windows-x64.zip LIFT-web.zip SHA256SUMS.txt \
+              --repo "$GITHUB_REPOSITORY" \
+              --title "LIFT $GITHUB_REF_NAME" \
+              --notes-file "$GITHUB_WORKSPACE/.github/release-notes.md" \
+              --verify-tag
+          fi
